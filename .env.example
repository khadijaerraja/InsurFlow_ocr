# Copy to .env (never commit .env) and fill in. Everything is optional except POSTGRES_PASSWORD and SECRET_KEY.

# --- Database (docker compose up -d starts it) -----------------------------------------------------
POSTGRES_USER=insurflow
POSTGRES_PASSWORD=
POSTGRES_DB=insurflow
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/insurflow   (overrides the POSTGRES_* values)

# --- Web application --------------------------------------------------------------------------------
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
APP_ENV=development          # production: Secure cookies, HSTS, registration closed, weak SECRET_KEY refused
# ALLOW_REGISTRATION=true    # production default is false: create accounts with `python -m src.cli create-user`

# --- Language models (free tiers). Without a key the assistant quotes the documents directly. -----
GROQ_API_KEY=
GEMINI_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# --- Embeddings: any 384-dimension sentence-transformers model (the default is English) -------------
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
